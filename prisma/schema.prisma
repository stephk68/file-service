// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



model Project {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  files File[]

  @@map("projects")
}

model File {
  id        Int     @id @default(autoincrement())
  url       String
  mimeType  String
  ProjectId   Int

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  owner Project @relation(fields: [ProjectId], references: [id], onDelete: Cascade)

  @@map("files")
}
