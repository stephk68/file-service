{
  "info": {
    "_postman_id": "file-service-api-2024",
    "name": "File-Service API",
    "description": "Collection complète pour l'API File-Service - Gestion de fichiers avec Supabase et authentification JWT",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "file-service"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "project_name",
      "value": "my-project-bucket",
      "type": "string"
    },
    {
      "key": "filepath",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Sign Up / Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Sauvegarder automatiquement le token JWT",
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.token) {",
                  "        pm.collectionVariables.set(\"jwt_token\", jsonData.token);",
                  "        console.log(\"Token JWT sauvegardé:\", jsonData.token);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"johndoe\",\n  \"password\": \"strongpassword123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/user/signUp",
              "host": ["{{base_url}}"],
              "path": ["user", "signUp"]
            },
            "description": "Authentification de l'utilisateur - Retourne un token JWT à utiliser pour les autres endpoints"
          },
          "response": []
        }
      ],
      "description": "Endpoints d'authentification des utilisateurs"
    },
    {
      "name": "Files",
      "item": [
        {
          "name": "Upload File",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Sauvegarder le filepath pour les autres requêtes",
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.filepath) {",
                  "        pm.collectionVariables.set(\"filepath\", jsonData.filepath);",
                  "        console.log(\"Filepath sauvegardé:\", jsonData.filepath);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Fichier à uploader"
                },
                {
                  "key": "project",
                  "value": "{{project_name}}",
                  "type": "text",
                  "description": "Nom du bucket/projet"
                },
                {
                  "key": "filepath",
                  "value": "folder1/myfile.txt",
                  "type": "text",
                  "description": "(Optionnel) Chemin dans le bucket"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/file",
              "host": ["{{base_url}}"],
              "path": ["file"]
            },
            "description": "Upload un fichier vers le bucket Supabase"
          },
          "response": []
        },
        {
          "name": "Get File URL",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/file?filepath={{filepath}}&project={{project_name}}",
              "host": ["{{base_url}}"],
              "path": ["file"],
              "query": [
                {
                  "key": "filepath",
                  "value": "{{filepath}}",
                  "description": "Chemin du fichier dans le bucket"
                },
                {
                  "key": "project",
                  "value": "{{project_name}}",
                  "description": "Nom du bucket/projet"
                }
              ]
            },
            "description": "Récupère l'URL d'accès à un fichier"
          },
          "response": []
        },
        {
          "name": "Update File",
          "request": {
            "method": "PATCH",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "(Optionnel) Nouveau fichier"
                },
                {
                  "key": "project",
                  "value": "{{project_name}}",
                  "type": "text",
                  "description": "Nom du bucket/projet"
                },
                {
                  "key": "filepath",
                  "value": "{{filepath}}",
                  "type": "text",
                  "description": "Chemin du fichier à mettre à jour"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/file",
              "host": ["{{base_url}}"],
              "path": ["file"]
            },
            "description": "Met à jour un fichier existant"
          },
          "response": []
        },
        {
          "name": "Delete File",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"filepath\": \"{{filepath}}\",\n  \"project\": \"{{project_name}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/file",
              "host": ["{{base_url}}"],
              "path": ["file"]
            },
            "description": "Supprime un fichier du bucket"
          },
          "response": []
        }
      ],
      "description": "Endpoints de gestion des fichiers",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{jwt_token}}",
            "type": "string"
          }
        ]
      }
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "List All Projects (Buckets)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/project",
              "host": ["{{base_url}}"],
              "path": ["project"]
            },
            "description": "Liste tous les buckets (projets) disponibles"
          },
          "response": []
        },
        {
          "name": "List Files in Bucket",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/project/{{project_name}}",
              "host": ["{{base_url}}"],
              "path": ["project", "{{project_name}}"]
            },
            "description": "Liste tous les fichiers et dossiers dans un bucket spécifique"
          },
          "response": []
        },
        {
          "name": "List Files in Folder",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/project/{{project_name}}/folder?path=folder1",
              "host": ["{{base_url}}"],
              "path": ["project", "{{project_name}}", "folder"],
              "query": [
                {
                  "key": "path",
                  "value": "folder1",
                  "description": "Chemin du dossier dans le bucket"
                }
              ]
            },
            "description": "Liste tous les fichiers et dossiers dans un dossier spécifique d'un bucket"
          },
          "response": []
        }
      ],
      "description": "Endpoints de gestion des projets/buckets",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{jwt_token}}",
            "type": "string"
          }
        ]
      }
    }
  ]
}
